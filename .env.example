# Stripe — see README.md "Payments (Stripe)" for full setup steps.
# Server-side secret key. NEVER prefix this with NEXT_PUBLIC_ or expose it to the client.
STRIPE_SECRET_KEY=sk_test_...

# Client-side publishable key. Safe to expose; required for the Payment Element to render.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Signing secret for the /api/webhooks/stripe endpoint (from `stripe listen` locally,
# or the webhook endpoint's settings in the Stripe Dashboard in production).
STRIPE_WEBHOOK_SECRET=whsec_...

# An existing Stripe Product ID that recurring donation Prices get attached to.
# Create one with: stripe products create --name "Donation"
STRIPE_DONATION_PRODUCT_ID=prod_...

# Used for canonical URLs and JSON-LD structured data — see src/config/site.ts.
NEXT_PUBLIC_SITE_URL=https://example.org

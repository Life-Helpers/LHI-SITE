NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_DONATION_PRODUCT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Admin CMS (/admin) — see README "Admin CMS"
# Production storage (required on Vercel, whose disk is temporary):
#   Postgres for content, users and submissions (Vercel's Neon integration sets DATABASE_URL/POSTGRES_URL)
DATABASE_URL=
#   Vercel Blob for uploaded files (create a *private* Blob store; Vercel sets this token)
BLOB_READ_WRITE_TOKEN=
#   Only if you created a public Blob store instead: BLOB_ACCESS=public
BLOB_ACCESS=
# Without DATABASE_URL: the folder for content, uploads and users. Must be a persistent, backed-up disk.
CMS_DATA_DIR=
# Required in production to create the first administrator at /admin/setup.
CMS_SETUP_TOKEN=
# Optional: session signing key. If unset, one is generated and kept in CMS_DATA_DIR.
CMS_SESSION_SECRET=
# Email (optional until connected). Without these, every email is kept in Admin → Email Outbox
# and can be sent later. EMAIL_PROVIDER: resend | sendgrid | postmark | brevo
EMAIL_PROVIDER=
EMAIL_API_KEY=
# e.g. Life Helpers Initiative <no-reply@lhinigeria.org> (the domain must be verified with the provider)
EMAIL_FROM=
EMAIL_REPLY_TO=
# Optional spam protection (Cloudflare Turnstile) for public forms. Leave empty to rely on
# rate limits and honeypots only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate limiting: by default the visitor IP is the right-most X-Forwarded-For entry (added by your proxy).
# If your host gives the real IP in its own header instead (e.g. cf-connecting-ip on Cloudflare), name it here.
CLIENT_IP_HEADER=

# Optional: shared rate limits across server instances (Upstash Redis, or Vercel's Redis/KV integration,
# which sets KV_REST_API_URL / KV_REST_API_TOKEN). Without these, each server instance counts on its own.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Home page live social feed (all optional; see src/lib/social-feed.ts).
# The Facebook Page timeline always shows live without any key. Each account
# below adds its newest posts to the social wall, refreshed every 15 minutes.
# ---------------------------------------------------------------------------
# YouTube needs no key; set the channel ID (UC…) to skip looking it up from the handle.
YOUTUBE_CHANNEL_ID=
# Facebook Page posts: the Page ID and a long-lived Page access token (pages_read_engagement).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Instagram professional account: a long-lived token from "Instagram API with Instagram Login".
INSTAGRAM_ACCESS_TOKEN=
# X (Twitter): an API bearer token on a plan that can read posts; X_USER_ID is optional.
X_BEARER_TOKEN=
X_USER_ID=
